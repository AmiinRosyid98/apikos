// KosManager — Prisma schema (MVP-1). Source of truth: PLAN.md §4.
// Design fixes applied:
//   (a) tenant_id on every table (RLS + middleware tenant-guard)
//   (b) occupancies table for tenancy history
//   (c) user_property_access pivot (not array)
//   (d) unique (tenantId, residentId, periodMonth, periodYear) on invoices
//   (e) AES-256-GCM ciphertext stored in nik / ktpPhotoKey, nikLast4 plaintext
//   (h) tenant_counters for per-tenant invoice numbering

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums (PLAN §4.3) ───────────────────────────
enum SubscriptionPlan {
  basic
  pro
  premium
}

enum SubscriptionStatus {
  active
  expired
  suspended
}

enum UserRole {
  owner
  manager
  admin
  finance
}

enum PropertyType {
  putra
  putri
  campur
}

enum LateFeeType {
  flat
  percentage
}

enum RoomStatus {
  empty
  occupied
  booking
  maintenance
  renovation
}

enum Gender {
  male
  female
}

enum ResidentStatus {
  active
  alumni
  blacklisted
}

enum InvoiceStatus {
  unpaid
  partial
  paid
  overdue
  cancelled
}

enum InvoiceItemType {
  rent
  electricity
  water
  internet
  other
}

enum PaymentMethod {
  cash
  transfer
  qris
  va
  ewallet
  other
}

enum OccupancyStatus {
  active
  ended
}

// In-App Notification module (PRD §6.18). Browser push (VAPID/web-push) is DEFERRED — these are
// in-app notifications only, emitted from existing business events.
enum NotificationType {
  payment_received
  booking_new
  maintenance_critical
  contract_expiring
  invoice_overdue
  general
}

enum MeterType {
  electricity
  water
}

// ── Maintenance Module (PRD §6.14) ──
enum MaintenancePriority {
  low
  medium
  high
  critical
}

enum MaintenanceStatus {
  open
  in_progress
  waiting_parts
  done
  cancelled
}

// ── Dokumen & Kontrak Module (PRD §6.15) ──
enum ContractStatus {
  draft
  active
  signed
  expired
  terminated
}

enum DocumentType {
  ktp
  sim
  kk
  contract
  other
}

// ── Deposit Management (PRD §6.6) ──
enum DepositMethod {
  cash
  transfer
  qris
  other
}

enum DepositStatus {
  held
  partially_refunded
  refunded
  forfeited
}

// ── Check-in / Check-out Digital (PRD §6.5) ──
// Single table for both directions (type enum) — see BACKEND_STATUS note (deviation from the
// PRD ERD's separate CHECKIN/CHECKOUT tables).
enum HandoverType {
  checkin
  checkout
}

// ── Booking Management (PRD §6.13) ──
// Booking-fee method (manual confirmation in MVP — no payment gateway yet).
enum BookingFeeMethod {
  cash
  transfer
  qris
  other
}

enum BookingFeeStatus {
  unpaid
  paid
  waived
}

// Booking lifecycle state machine: pending → confirmed → converted, or → cancelled / expired.
enum BookingStatus {
  pending
  confirmed
  converted
  cancelled
  expired
}

// How a booking was submitted (PRD §6.13). `internal` = created by staff via the authenticated
// /bookings API; `public` = self-service submission via the public booking link (no auth, resolved
// from the property's public_slug). Lets the existing bookings list distinguish/triage leads.
enum BookingSource {
  internal
  public
}

// ── WhatsApp + Reminder Otomatis (PRD §6.9, §6.10) ──
// Template categories. `custom` + `broadcast` skip the (tenant, property, type) uniqueness so
// multiple may exist; the others are one-per-scope defaults.
enum WaTemplateType {
  invoice_new
  reminder_due
  reminder_overdue
  payment_received
  contract_expiry
  broadcast
  custom
}

// Send-log status. `stub` = recorded but NOT actually sent (StubProvider / demo mode); `sent` =
// dispatched via a real provider (Fonnte); `queued`/`failed` for the real-provider lifecycle.
enum WaMessageStatus {
  queued
  sent
  failed
  stub
}

// ── Payment Gateway (PRD §6.8) ──
// Provider that produced the transaction. `stub` = no real money (StubProvider / demo mode);
// `midtrans` = real Snap/Core API (used only when MIDTRANS_SERVER_KEY is set).
enum PaymentGatewayProvider {
  stub
  midtrans
}

// Available payment methods. The plan gates WHICH of these a tenant may use (PRD §12.2):
// Basic = qris only, Pro = qris + va_*, Premium = all.
enum PaymentGatewayMethod {
  qris
  va_bca
  va_bni
  va_bri
  va_mandiri
  va_permata
  gopay
  ovo
  dana
  shopeepay
  linkaja
}

// Gateway transaction lifecycle. `pending` = charge created, awaiting payment; `paid` = settled
// (a Payment row is recorded on the invoice); `expired`/`failed` = terminal non-paid states.
enum PaymentGatewayStatus {
  pending
  paid
  expired
  failed
}

// ─────────────────────────── Tables ───────────────────────────
model Tenant {
  id                    String             @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String             @unique
  subscriptionPlan      SubscriptionPlan   @default(basic) @map("subscription_plan")
  subscriptionStatus    SubscriptionStatus @default(active) @map("subscription_status")
  subscriptionExpiresAt DateTime?          @map("subscription_expires_at") @db.Timestamptz
  maxProperties         Int                @default(1) @map("max_properties")
  maxRooms              Int                @default(20) @map("max_rooms")
  maxUsers              Int                @default(2) @map("max_users")
  waProvider            String?            @map("wa_provider")
  waApiKeyEnc           String?            @map("wa_api_key_enc")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  counter        TenantCounter?
  users          User[]
  properties     Property[]
  rooms          Room[]
  residents      Resident[]
  occupancies    Occupancy[]
  invoices       Invoice[]
  invoiceItems   InvoiceItem[]
  payments       Payment[]
  auditLogs      AuditLog[]
  files          FileObject[]
  invites        Invite[]
  refreshTokens  RefreshToken[]
  meterReadings  MeterReading[]
  depositRecords DepositRecord[]
  handoverRecords HandoverRecord[]
  expenseCategories ExpenseCategory[]
  expenses       Expense[]
  bookings       Booking[]
  waTemplates    WaTemplate[]
  waMessages     WaMessage[]
  paymentGatewayTxns PaymentGatewayTxn[]
  vendors             Vendor[]
  maintenanceTickets  MaintenanceTicket[]
  contractTemplates   ContractTemplate[]
  contracts           Contract[]
  documents           DocumentRecord[]
  notifications       Notification[]
  apiKeys             ApiKey[]

  @@map("tenants")
}

model TenantCounter {
  tenantId           String @id @map("tenant_id") @db.Uuid
  invoiceSeqYear     Int    @default(0) @map("invoice_seq_year")
  invoiceSeq         Int    @default(0) @map("invoice_seq")
  // Per-tenant maintenance-ticket numbering (TKT-{YEAR}-{SEQ}). Same pattern as the invoice seq.
  maintenanceSeqYear Int    @default(0) @map("maintenance_seq_year")
  maintenanceSeq     Int    @default(0) @map("maintenance_seq")
  // Per-tenant contract numbering (KTR-{YEAR}-{SEQ}). Same pattern as the invoice seq (PRD §6.15).
  contractSeqYear    Int    @default(0) @map("contract_seq_year")
  contractSeq        Int    @default(0) @map("contract_seq")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_counters")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  phone           String?
  role            UserRole  @default(owner)
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  // Per-type in-app notification on/off prefs (PRD §6.18). NULL = all enabled (handled in code).
  // Shape: { "payment_received": true, "booking_new": false, ... }. Missing key = enabled.
  notificationPrefs Json?   @map("notification_prefs")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyAccess UserPropertyAccess[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@index([tenantId])
  @@map("users")
}

model UserPropertyAccess {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([tenantId])
  @@index([propertyId])
  @@map("user_property_access")
}

model Invite {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  fullName   String    @map("full_name")
  role       UserRole
  tokenHash  String    @map("token_hash")
  propertyIds String[]  @map("property_ids") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  invitedBy  String    @map("invited_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tokenHash])
  @@map("invites")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model Property {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  name               String
  type               PropertyType @default(campur)
  address            String
  city               String
  province           String
  lat                Decimal?     @db.Decimal(10, 7)
  lng                Decimal?     @db.Decimal(10, 7)
  facilities         Json         @default("[]")
  billingDay         Int          @default(1) @map("billing_day")
  lateFeeType        LateFeeType  @default(flat) @map("late_fee_type")
  lateFeeValue       Decimal      @default(0) @map("late_fee_value") @db.Decimal(12, 2)
  lateFeeGraceDays   Int          @default(0) @map("late_fee_grace_days")
  electricityPriceKwh Decimal     @default(0) @map("electricity_price_kwh") @db.Decimal(12, 2)
  // Acquisition / total investment cost of the property (land+build+furnish). Used by the ROI
  // report (PRD §6.12 tambahan, §19). Nullable — ROI handles a null/zero investment gracefully
  // (roiPercent/paybackYears become null; the UI prompts "atur nilai investasi").
  investmentValue    Decimal?     @map("investment_value") @db.Decimal(14, 2)
  // Public Landing Page + Public Booking Link (PRD §6.2, §6.13). `publicSlug` is the marketing
  // URL slug (`/p/:slug`); UNIQUE so it resolves a single tenant. `publicEnabled` gates whether the
  // public endpoints serve this property at all (disabled OR unknown slug → 404, no existence leak).
  publicSlug         String?      @unique @map("public_slug")
  publicEnabled      Boolean      @default(false) @map("public_enabled")
  // Reminder Otomatis config (PRD §6.10). null → a sane default applied in code. Shape e.g.
  // { enabled, offsets:{h7,h3,h0,h3plus,h7plus}, contractExpiry:{h30,h14,h7} }.
  reminderConfig     Json?        @map("reminder_config")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms          Room[]
  residents      Resident[]
  occupancies    Occupancy[]
  invoices       Invoice[]
  propertyAccess UserPropertyAccess[]
  meterReadings  MeterReading[]
  depositRecords  DepositRecord[]
  handoverRecords HandoverRecord[]
  expenses        Expense[]
  bookings        Booking[]
  waTemplates     WaTemplate[]
  waMessages      WaMessage[]
  maintenanceTickets MaintenanceTicket[]
  contractTemplates ContractTemplate[]
  contracts         Contract[]
  documents         DocumentRecord[]

  @@index([tenantId])
  @@map("properties")
}

model Room {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  propertyId String     @map("property_id") @db.Uuid
  roomNumber String     @map("room_number")
  roomType   String     @map("room_type")
  floor      Int?
  areaM2     Decimal?   @map("area_m2") @db.Decimal(8, 2)
  basePrice  Decimal    @map("base_price") @db.Decimal(12, 2)
  status     RoomStatus @default(empty)
  facilities Json       @default("[]")
  photos     Json       @default("[]")
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residents     Resident[]
  occupancies   Occupancy[]
  invoices      Invoice[]
  meterReadings MeterReading[]
  depositRecords  DepositRecord[]
  handoverRecords HandoverRecord[]
  bookings        Booking[]
  maintenanceTickets MaintenanceTicket[]
  contracts       Contract[]

  @@unique([propertyId, roomNumber])
  @@index([tenantId])
  @@index([propertyId])
  @@map("rooms")
}

model Resident {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  propertyId      String         @map("property_id") @db.Uuid
  roomId          String?        @map("room_id") @db.Uuid
  fullName        String         @map("full_name")
  nikEnc          String?        @map("nik_enc") // AES-256-GCM ciphertext
  nikLast4        String?        @map("nik_last4") // plaintext last 4 for search/display
  phone           String
  email           String?
  occupation      String?
  gender          Gender?
  status          ResidentStatus @default(active)
  monthlyRent     Decimal        @map("monthly_rent") @db.Decimal(12, 2)
  checkInDate     DateTime       @map("check_in_date") @db.Date
  contractEndDate DateTime?      @map("contract_end_date") @db.Date
  checkOutDate    DateTime?      @map("check_out_date") @db.Date
  ktpPhotoKeyEnc  String?        @map("ktp_photo_key_enc") // AES-256-GCM ciphertext of R2 key
  selfieKey       String?        @map("selfie_key")
  emergencyName   String?        @map("emergency_name")
  emergencyPhone  String?        @map("emergency_phone")
  emergencyRelation String?      @map("emergency_relation")
  internalNotes   String?        @map("internal_notes")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room        Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  occupancies Occupancy[]
  invoices    Invoice[]
  depositRecords  DepositRecord[]
  handoverRecords HandoverRecord[]
  // Bookings that converted into THIS resident (normally 0 or 1). Nullable back-ref.
  convertedFromBookings Booking[]
  waMessages            WaMessage[]
  contracts             Contract[]
  documents             DocumentRecord[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([roomId])
  @@map("residents")
}

model Occupancy {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  residentId  String          @map("resident_id") @db.Uuid
  propertyId  String          @map("property_id") @db.Uuid
  roomId      String          @map("room_id") @db.Uuid
  monthlyRent Decimal         @map("monthly_rent") @db.Decimal(12, 2)
  startDate   DateTime        @map("start_date") @db.Date
  endDate     DateTime?       @map("end_date") @db.Date
  status      OccupancyStatus @default(active)
  endReason   String?         @map("end_reason")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Partial unique index (one active occupancy per room) is added via raw SQL in migration.
  @@index([tenantId])
  @@index([residentId])
  @@index([roomId])
  @@map("occupancies")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  invoiceNumber String        @map("invoice_number")
  propertyId    String        @map("property_id") @db.Uuid
  roomId        String?       @map("room_id") @db.Uuid
  residentId    String        @map("resident_id") @db.Uuid
  periodMonth   Int           @map("period_month")
  periodYear    Int           @map("period_year")
  dueDate       DateTime      @map("due_date") @db.Date
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  lateFee       Decimal       @default(0) @map("late_fee") @db.Decimal(12, 2)
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status        InvoiceStatus @default(unpaid)
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  resident Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments Payment[]
  waMessages WaMessage[]
  gatewayTxns PaymentGatewayTxn[]

  @@unique([tenantId, residentId, periodMonth, periodYear])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([propertyId])
  @@index([residentId])
  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  type        InvoiceItemType @default(rent)
  description String
  quantity    Decimal         @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal         @db.Decimal(12, 2)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  invoiceId  String        @map("invoice_id") @db.Uuid
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod @default(cash)
  paidAt     DateTime      @map("paid_at") @db.Timestamptz
  reference  String?
  proofKey   String?       @map("proof_key")
  recordedBy String        @map("recorded_by") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  gatewayTxn PaymentGatewayTxn?

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

model MeterReading {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  propertyId       String    @map("property_id") @db.Uuid
  roomId           String    @map("room_id") @db.Uuid
  type             MeterType @default(electricity)
  periodMonth      Int       @map("period_month")
  periodYear       Int       @map("period_year")
  previousReading  Decimal   @default(0) @map("previous_reading") @db.Decimal(14, 3)
  currentReading   Decimal   @map("current_reading") @db.Decimal(14, 3)
  usage            Decimal   @default(0) @db.Decimal(14, 3)
  pricePerUnit     Decimal   @map("price_per_unit") @db.Decimal(12, 2)
  amount           Decimal   @default(0) @db.Decimal(14, 2)
  photoUrl         String?   @map("photo_url")
  photoKey         String    @map("photo_key")
  recordedByUserId String?   @map("recorded_by_user_id") @db.Uuid
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roomId, type, periodMonth, periodYear])
  @@index([tenantId])
  @@index([roomId])
  @@index([propertyId])
  @@map("meter_readings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  userName   String?  @map("user_name")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([entityType])
  @@index([userId])
  @@map("audit_logs")
}

model FileObject {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String   @unique
  purpose     String
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  isPrivate   Boolean  @default(true) @map("is_private")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("files")
}

// ── Deposit Management (PRD §6.6) ──
model DepositRecord {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  residentId       String        @map("resident_id") @db.Uuid
  propertyId       String        @map("property_id") @db.Uuid
  roomId           String?       @map("room_id") @db.Uuid
  amount           Decimal       @db.Decimal(12, 2)
  method           DepositMethod @default(cash)
  receivedDate     DateTime      @map("received_date") @db.Date
  status           DepositStatus @default(held)
  refundedAmount   Decimal       @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  refundedDate     DateTime?     @map("refunded_date") @db.Date
  deductionAmount  Decimal       @default(0) @map("deduction_amount") @db.Decimal(12, 2)
  deductionNotes   String?       @map("deduction_notes")
  notes            String?
  recordedByUserId String?       @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([residentId])
  @@index([propertyId])
  @@index([status])
  @@map("deposit_records")
}

// ── Check-in / Check-out Digital — berita acara (PRD §6.5) ──
model HandoverRecord {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @map("tenant_id") @db.Uuid
  residentId           String       @map("resident_id") @db.Uuid
  propertyId           String       @map("property_id") @db.Uuid
  roomId               String?      @map("room_id") @db.Uuid
  type                 HandoverType
  date                 DateTime     @db.Date
  photoKeys            Json         @default("[]") @map("photo_keys")
  inventory            Json         @default("[]")
  initialMeterElectricity Decimal?  @map("initial_meter_electricity") @db.Decimal(14, 3)
  signatureKey         String?      @map("signature_key")
  notes                String?
  recordedByUserId     String?      @map("recorded_by_user_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([residentId])
  @@index([propertyId])
  @@index([type])
  @@map("handover_records")
}

// ── Finance / Keuangan (PRD §6.12) ──
// Expense categories per tenant. `isDefault` marks the seeded defaults (Listrik PLN, etc.).
model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("expense_categories")
}

// A recorded expense. `propertyId` nullable = tenant-wide overhead (not tied to one property).
model Expense {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  propertyId       String?  @map("property_id") @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  amount           Decimal  @db.Decimal(12, 2)
  date             DateTime @db.Date
  description      String?
  vendorName       String?  @map("vendor_name")
  receiptKey       String?  @map("receipt_key")
  recordedByUserId String?  @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([propertyId])
  @@index([categoryId])
  @@index([date])
  @@map("expenses")
}

// ── Booking Management (PRD §6.13) ──
// INTERNAL booking only in this build (public self-service link deferred — see the seam in
// bookings.service.ts / bookings.routes.ts). Booking fee is confirmed MANUALLY (no payment
// gateway). State machine: pending → confirmed → converted | cancelled | expired.
model Booking {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  propertyId          String           @map("property_id") @db.Uuid
  // Nullable so a PUBLIC inquiry without a chosen room (room-less lead) can be recorded. An
  // internal/room-specific booking always sets it. SetNull keeps historical bookings if a room is deleted.
  roomId              String?          @map("room_id") @db.Uuid
  prospectName        String           @map("prospect_name")
  prospectPhone       String           @map("prospect_phone")
  prospectEmail       String?          @map("prospect_email")
  plannedCheckInDate  DateTime         @map("planned_check_in_date") @db.Date
  bookingFeeAmount    Decimal          @default(0) @map("booking_fee_amount") @db.Decimal(12, 2)
  bookingFeeMethod    BookingFeeMethod @default(cash) @map("booking_fee_method")
  feeStatus           BookingFeeStatus @default(unpaid) @map("fee_status")
  feeDueAt            DateTime         @map("fee_due_at") @db.Timestamptz
  status              BookingStatus    @default(pending)
  // Submission origin (internal staff vs public link). See BookingSource.
  source              BookingSource    @default(internal)
  // Optional prospect message captured on a public submission ("kapan bisa lihat kamar?", etc).
  message             String?
  convertedResidentId String?          @map("converted_resident_id") @db.Uuid
  notes               String?
  recordedByUserId    String?          @map("recorded_by_user_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room              Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  convertedResident Resident? @relation(fields: [convertedResidentId], references: [id], onDelete: SetNull)

  // Only one ACTIVE (pending|confirmed) booking per room — enforced via a partial unique index
  // added in raw SQL in the migration (Prisma cannot express a partial unique index here).
  @@index([tenantId])
  @@index([propertyId])
  @@index([roomId])
  @@index([status])
  @@index([source])
  @@map("bookings")
}

// ── WhatsApp templates (PRD §6.9) ──
// A reusable message template per tenant (optionally per property). `body` holds {variabel}
// placeholders rendered against resident/invoice/property context (see whatsapp.service render).
// `propertyId` null = tenant-level default. For non-custom/broadcast types, only one template per
// (tenant, property, type) is allowed (the @@unique below). Custom/broadcast skip uniqueness by
// using a distinct name.
model WaTemplate {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  propertyId String?        @map("property_id") @db.Uuid
  type       WaTemplateType @default(custom)
  name       String
  body       String
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // One default template per (tenant, property, type). propertyId null is treated as a distinct
  // scope by Postgres (NULLs are distinct), so a tenant default + per-property override coexist.
  // The service additionally guards custom/broadcast so they never collide on this constraint.
  @@unique([tenantId, propertyId, type])
  @@index([tenantId])
  @@index([propertyId])
  @@map("wa_templates")
}

// ── WhatsApp send log (PRD §6.9) ──
// Every send path (invoice send, broadcast, reminder cron) writes one row here. In STUB mode the
// row is recorded with status `stub` (message NOT actually sent) so the UI can show "mode demo".
model WaMessage {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  propertyId      String?         @map("property_id") @db.Uuid
  residentId      String?         @map("resident_id") @db.Uuid
  invoiceId       String?         @map("invoice_id") @db.Uuid
  toPhone         String          @map("to_phone")
  toName          String?         @map("to_name")
  templateType    WaTemplateType? @map("template_type")
  // Reminder dedup marker — e.g. "reminder_due:H-7" / "contract_expiry:H-30". Lets the reminder
  // sweep be idempotent: a unique (invoice/resident, reminderKey) is never sent twice.
  reminderKey     String?         @map("reminder_key")
  body            String
  status          WaMessageStatus @default(stub)
  provider        String?
  providerMessageId String?       @map("provider_message_id")
  error           String?
  sentByUserId    String?         @map("sent_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  resident Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([propertyId])
  @@index([residentId])
  @@index([invoiceId])
  @@index([status])
  @@index([createdAt])
  @@map("wa_messages")
}

// ── Payment Gateway transaction (PRD §6.8) ──
// One row per charge. The provider (stub|midtrans) creates it `pending` with rendered instructions
// (QR string / VA number / e-wallet deeplink). On a verified `paid` webhook a Payment row is
// recorded on the invoice and linked back here via paymentId, and status flips to `paid`. The whole
// charge/verify path goes through payment-gateway.service → provider, so swapping the provider in
// (set MIDTRANS_SERVER_KEY) is a config-only change.
model PaymentGatewayTxn {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  invoiceId    String                 @map("invoice_id") @db.Uuid
  // Set once the txn is paid and a Payment ledger row has been recorded (links txn ↔ payment).
  paymentId    String?                @unique @map("payment_id") @db.Uuid
  provider     PaymentGatewayProvider @default(stub)
  method       PaymentGatewayMethod
  // Provider's transaction reference (Midtrans order_id / our stub ref). Unique → webhook idempotency.
  providerRef  String                 @unique @map("provider_ref")
  amount       Decimal                @db.Decimal(12, 2)
  status       PaymentGatewayStatus   @default(pending)
  // Rendered payment instructions for the UI: { type:'qris'|'va'|'ewallet', qrString?, vaNumber?,
  // bank?, deeplink?, expiresAt? }.
  instructions Json?
  paidAt       DateTime?              @map("paid_at") @db.Timestamptz
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
  @@index([tenantId])
  @@index([status])
  @@map("payment_gateway_txns")
}

// ── Maintenance Module (PRD §6.14) — INTERNAL only (public tenant-submitted-report link is
// DEFERRED — see the PUBLIC REPORT SEAM in maintenance.service.ts). Self-contained: no external
// creds. Vendor DB + tickets + per-room history + optional cost→expense seam.

// A repair/maintenance vendor (tukang). `skill` = keahlian (e.g. listrik/ledeng/AC).
model Vendor {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  skill     String?
  phone     String?
  rating    Decimal? @db.Decimal(2, 1) // 1.0–5.0
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets MaintenanceTicket[]

  @@index([tenantId])
  @@index([tenantId, skill])
  @@map("vendors")
}

// A maintenance ticket. `roomId` null = area umum / common area. `ticketNumber` is per-tenant
// sequential (TKT-{YEAR}-{SEQ}) via tenant_counters.maintenanceSeq. `vendorId` = the assignee.
model MaintenanceTicket {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  propertyId       String              @map("property_id") @db.Uuid
  roomId           String?             @map("room_id") @db.Uuid
  ticketNumber     String              @map("ticket_number")
  title            String
  description      String
  category         String?
  priority         MaintenancePriority @default(medium)
  status           MaintenanceStatus   @default(open)
  vendorId         String?             @map("vendor_id") @db.Uuid
  photoKeys        Json                @default("[]") @map("photo_keys")
  cost             Decimal             @default(0) @db.Decimal(12, 2)
  reportedByUserId String?             @map("reported_by_user_id") @db.Uuid
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz
  // Set once when the ticket's cost is logged as a Finance expense (cost→expense seam) — prevents
  // double-logging on re-runs.
  expenseId        String?             @map("expense_id") @db.Uuid
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  vendor   Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, ticketNumber])
  @@index([tenantId, status])
  @@index([tenantId, roomId])
  @@index([tenantId])
  @@index([vendorId])
  @@map("maintenance_tickets")
}

// ── Dokumen & Kontrak Module (PRD §6.15) ──
// Customizable contract template per property (`propertyId` null = tenant default). `body` holds
// {variabel} placeholders rendered against resident/room/property context at generation time.
model ContractTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  propertyId String?  @map("property_id") @db.Uuid
  name       String
  body       String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, propertyId])
  @@map("contract_templates")
}

// A generated contract for a resident. `body` is the RENDERED snapshot at generation time (so the
// document is stable even if the source template later changes). `contractNumber` is per-tenant
// sequential (KTR-{YEAR}-{SEQ}) via tenant_counters.contractSeq. Signature keys reference uploaded
// signature image files (presign stub).
model Contract {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  residentId           String         @map("resident_id") @db.Uuid
  propertyId           String         @map("property_id") @db.Uuid
  roomId               String?        @map("room_id") @db.Uuid
  templateId           String?        @map("template_id") @db.Uuid
  contractNumber       String         @map("contract_number")
  body                 String
  status               ContractStatus @default(draft)
  startDate            DateTime       @map("start_date") @db.Date
  endDate              DateTime       @map("end_date") @db.Date
  signedAt             DateTime?      @map("signed_at") @db.Timestamptz
  residentSignatureKey String?        @map("resident_signature_key")
  ownerSignatureKey    String?        @map("owner_signature_key")
  notes                String?
  createdByUserId      String?        @map("created_by_user_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([tenantId, contractNumber])
  @@index([tenantId])
  @@index([tenantId, residentId])
  @@index([tenantId, propertyId])
  @@index([tenantId, status])
  @@map("contracts")
}

// Lightweight document registry with optional expiry (KTP/SIM/KK/contract scan/other). `fileKey`
// references an uploaded file (presign stub). `expiresAt` powers the renewal-notification seam.
model DocumentRecord {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  residentId       String?      @map("resident_id") @db.Uuid
  propertyId       String?      @map("property_id") @db.Uuid
  type             DocumentType @default(other)
  name             String
  fileKey          String       @map("file_key")
  expiresAt        DateTime?    @map("expires_at") @db.Date
  notes            String?
  uploadedByUserId String?      @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resident Resident? @relation(fields: [residentId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, residentId])
  @@index([tenantId, expiresAt])
  @@map("documents")
}

// ── In-App Notification module (PRD §6.18) ──
// Per-user notification center row, emitted from existing business events by the notification
// service (best-effort / failure-isolated). `link` is an in-app deep link (e.g. /invoices/:id).
// `entityType`/`entityId` reference the source business entity (used for idempotency guards too).
// Browser push (VAPID/web-push) is DEFERRED — see the seam in notification.service.ts.
model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String
  body       String
  link       String?
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("notifications")
}

// Public API key (PRD Modul 22 — Premium-only). Authenticates third-party REST access to the
// read-focused external API (/api/ext/v1). The plaintext key is shown ONCE on create and never
// stored — only its sha256 hash (keyHash) is persisted, plus a short visible prefix (keyPrefix,
// e.g. "kos_live_AbCd…") for display in the dashboard. Scopes restrict which endpoints the key
// can reach. The key only works while the owning tenant is on the Premium plan (enforced at
// auth time), so downgrading instantly disables every key.
model ApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String
  keyPrefix       String    @map("key_prefix")
  keyHash         String    @unique @map("key_hash")
  scopes          Json
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  isActive        Boolean   @default(true) @map("is_active")
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyPrefix])
  @@map("api_keys")
}
