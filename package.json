{
  "name": "apikos",
  "version": "0.1.0",
  "description": "KosManager backend API (Express + TypeScript + Prisma) — MVP-1",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "ts-node-dev --respawn --transpile-only --exit-child src/jobs/worker.ts",
    "worker:start": "node dist/src/jobs/worker.js",
    "test:jobs": "node --require ts-node/register --test tests/jobs.invoiceGenerator.test.ts",
    "test:meters": "node --require ts-node/register --test tests/meters.test.ts",
    "test:deposits": "node --require ts-node/register --test tests/deposits.test.ts",
    "test:handovers": "node --require ts-node/register --test tests/handovers.test.ts",
    "test:finance": "node --require ts-node/register --test tests/finance.test.ts",
    "test:bookings": "node --require ts-node/register --test tests/bookings.test.ts",
    "test:reports": "node --require ts-node/register --test tests/reports.test.ts",
    "test:whatsapp": "node --require ts-node/register --test tests/whatsapp.test.ts",
    "test:payments": "node --require ts-node/register --test tests/payments.test.ts",
    "test:maintenance": "node --require ts-node/register --test tests/maintenance.test.ts",
    "test:contracts": "node --require ts-node/register --test tests/contracts.test.ts",
    "test:notifications": "node --require ts-node/register --test tests/notifications.test.ts",
    "test:public": "node --require ts-node/register --test tests/public.test.ts",
    "test:apikeys": "node --require ts-node/register --test tests/apikeys.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "seed": "ts-node-dev --transpile-only prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node-dev --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.78.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jose": "^5.9.6",
    "pdfkit": "^0.15.2",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
